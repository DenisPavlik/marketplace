# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public URL of the app (used for OAuth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ImageKit — Developer options
NEXT_PUBLIC_IK_ENDPOINT=
NEXT_PUBLIC_IK_PUBLIC_KEY=
IK_PRIVATE_KEY=


# Demo account shown on the sign-in page
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=

# Protects /api/cron/keep-alive (Vercel sets the Authorization header automatically)
CRON_SECRET=

# Shopping assistant: Anthropic API key (console.anthropic.com → API keys)
ANTHROPIC_API_KEY=
# Any random string; signs the assistant rate-limit checks
ASSISTANT_RATE_SECRET=
